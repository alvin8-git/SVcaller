process {
    cpus   = { check_max( 2    * task.attempt, 'cpus'   ) }
    memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus   = { check_max( 1                  , 'cpus'   ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_low {
        cpus   = { check_max( 4     * task.attempt, 'cpus'   ) }
        memory = { check_max( 6.GB  * task.attempt, 'memory' ) }   // was 12 GB; measured peaks of the process_low tasks are <= 2 GB
        time   = { check_max( 6.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }   // was 36 GB; measured peaks <= 6 GB. A retry doubles it.
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
    withName: 'SAMTOOLS_FILTER_CHROMS' {
        // Scales with the per-sample core budget (--max_cpus): 3/4 of it, at least 8.
        // The filter shards the BAM into ~25 Mb windows (bin/filter_chroms.sh), so it
        // uses every core it is given. Memory use is ~0.3 GB; 8 GB is headroom.
        cpus   = { check_max( Math.max(8, ((params.max_cpus as int) * 3 / 4) as int), 'cpus' ) }
        memory = { check_max( 8.GB  * task.attempt,  'memory' ) }
        time   = { check_max( 24.h  * task.attempt,  'time'   ) }
    }
    withName: 'BWAMEM2_ALIGN' {
        cpus   = { check_max( 16,                    'cpus'   ) }
        memory = { check_max( 24.GB * task.attempt,  'memory' ) }
        time   = { check_max( 24.h  * task.attempt,  'time'   ) }
    }
    withName: 'PICARD_MARKDUP' {
        cpus   = { check_max( 4,                     'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt,  'memory' ) }
        time   = { check_max( 12.h  * task.attempt,  'time'   ) }
    }
    withName: 'GATK_COLLECT_COUNTS' {
        cpus   = { check_max( 4,                    'cpus'   ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
    }
    withName: 'MANTA_CALL' {
        cpus   = { check_max( 16,                    'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt,  'memory' ) }
        time   = { check_max( 24.h  * task.attempt,  'time'   ) }
    }
    // NOTE on selectors: a `withName` selector string that also appears in a profile
    // config (conf/docker.config sets `container` per process) REPLACES this block
    // instead of merging with it. `withName: 'DELLY_CALL_SVTYPE'` here was therefore
    // silently ignored under -profile docker (verified with `nextflow config`): Delly
    // ran with process_medium's 8 CPU / 36 GB, so at most two ran at once on a 100 GB
    // budget. Hence the grouped selectors below, whose strings are unique to this
    // file. `delly call` and `strling` are single-threaded; Delly's peak RSS is 4.1 GB
    // and STRling's 0.9 GB. Retries scale memory. Reservation-only: results unchanged.
    withName: 'DELLY_CALL_SVTYPE|STRLING_CALL' {
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    }
    // Right-sized reservations (measured peak RSS and %CPU, 30X WGS). The label
    // defaults (process_medium: 8 cpus / 36 GB) were reserved by tools that use one
    // core and under 6 GB, which left cores idle while ready tasks waited for slots.
    withName: 'CNVPYTOR_CALL|GATK_GCNV_CALL' {
        // gCNV: CollectReadCounts dominates and is effectively single-threaded (~108% CPU),
        // peak RSS 5.8 GB, JVM heap = 0.85 x task.memory (result independent of heap).
        // CNVpytor runs single-process (no -j; threaded output not verified identical):
        // ~210% CPU, peak RSS 1.9 GB. Both are off the critical path.
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: 'SAMTOOLS_FLAGSTAT' {
        // samtools flagstat -@ ${task.cpus}; output is independent of threads.
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
    }
    withName: 'PICARD_INSERT_SIZE' {
        // QC only (feeds the HTML report/MultiQC, no call). Single-threaded Picard,
        // off the critical path; runs concurrently from t=0. Peak RSS 1.4 GB.
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    }
    withName: 'MOSDEPTH' {
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
    withLabel: process_gridss {
        cpus   = { check_max( 16                 , 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
    withName: 'GRIDSS_CALL' {
        // 3 retries: 32 → 64 → 96 GB. GRIDSS is most likely to silent-OOM.
        // For HPC/SLURM deployments add: scratch = true
        maxRetries = 3
    }
    withName: 'SVABA_CALL' {
        // SVABA is memory-bound; fix CPUs so retry doesn't claim 32 slots.
        cpus = { check_max( 16, 'cpus' ) }
    }
}
